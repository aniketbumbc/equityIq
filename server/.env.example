# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
TWELVEDATA_API_KEY=
TAVILY_API_KEY=
ALPHAVANTAGE_API_KEY=

# Site origins allowed to call the API, comma-separated. Defaults to localhost:3000 when unset.
# CORS_ORIGINS=https://example.com,https://www.example.com

# New questions each visitor may ask per rolling window. Set RATE_LIMIT_QUESTIONS=0 to turn the limit off.
# RATE_LIMIT_QUESTIONS=5
# RATE_LIMIT_WINDOW_MINUTES=30
